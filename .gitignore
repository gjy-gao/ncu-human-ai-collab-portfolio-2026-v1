# ============================================================
# 通用 .gitignore 模板（适合跨学科新生的课程作业仓库）
# 作用：告诉 Git「这些文件不要进仓库」，保持仓库干净、体积小
# ============================================================

# ---------- 1. macOS 系统垃圾文件 ----------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ---------- 2. Windows 系统垃圾文件 ----------
Thumbs.db
Desktop.ini
ehthumbs.db

# ---------- 3. 编辑器 / IDE 配置 ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.swp
*~

# ---------- 4. Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- 5. Jupyter Notebook ----------
.ipynb_checkpoints
*.ipynb_checkpoints

# ---------- 6. Node.js / 前端 ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
.cache/
.parcel-cache/
.next/
out/
coverage/

# ---------- 7. R 语言 ----------
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ---------- 8. MATLAB ----------
*.asv
*.m~

# ---------- 9. C / C++ / Java 编译产物 ----------
*.o
*.obj
*.exe
*.out
*.a
*.so
*.dylib
*.class
*.jar
bin/
obj/
cmake-build-*/

# ---------- 10. LaTeX ----------
*.aux
*.log
*.toc
*.out
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk

# ---------- 11. 数据与大文件（不建议入库） ----------
*.csv
*.tsv
*.xlsx
*.xls
*.db
*.sqlite
*.sqlite3
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.mp4
*.mov
*.avi
*.mkv
*.pdf

# ---------- 12. 环境变量与密钥（安全第一） ----------
.env
.env.*
.env.local
*.pem
*.key
secrets/
config.local.*

# ---------- 13. 日志与临时文件 ----------
*.log
logs/
tmp/
temp/
*.tmp
